<!--
  SOCForge — Custom Wazuh Decoders (Phase 13)
  ==============================================================================
  Decodes structured container JSON telemetry from OWASP Juice Shop and
  structured simulation audit logs from SOCForge adversary emulation hosts.
  ==============================================================================
-->

<!-- OWASP Juice Shop Docker JSON Decoder -->
<decoder name="socforge-juice-shop">
  <prematch>{"log":</prematch>
</decoder>

<decoder name="socforge-juice-shop-http">
  <parent>socforge-juice-shop</parent>
  <regex offset="after_parent">"log":"(\w+) (\S+) HTTP</regex>
  <order>http_method, url</order>
</decoder>

<decoder name="socforge-juice-shop-status">
  <parent>socforge-juice-shop</parent>
  <regex offset="after_parent">"log":"HTTP/\S+ (\d+) (\.+)"</regex>
  <order>http_status, status_message</order>
</decoder>

<decoder name="socforge-juice-shop-error">
  <parent>socforge-juice-shop</parent>
  <prematch>Error|SQLITE|Sequelize</prematch>
  <regex offset="after_parent">"log":"(\.+)"</regex>
  <order>error_message</order>
</decoder>

<!-- SOCForge Ground-Truth Simulation Audit Log Decoder -->
<decoder name="socforge-simulation">
  <prematch>{"timestamp":</prematch>
</decoder>

<decoder name="socforge-simulation-fields">
  <parent>socforge-simulation</parent>
  <regex offset="after_parent">"simulation_id":"(\S+)","scenario_id":"(\S+)","technique_id":"(\S+)","test_name":"(\.+)","target_ip":"(\S+)"</regex>
  <order>simulation_id, scenario_id, technique_id, test_name, target_ip</order>
</decoder>
