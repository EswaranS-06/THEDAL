# ==============================================================================
# SOCForge — Nginx Configuration for DVWA (:{{ nginx_port }})
# ==============================================================================
server {
    listen {{ nginx_port }} default_server;
    listen [::]:{{ nginx_port }} default_server;

    server_name {{ nginx_server_name }};
    root {{ dvwa_install_dir }};
    index index.php index.html index.htm;

    # Standard Web Access & Error Logs for Wazuh SIEM Ingestion
    access_log {{ nginx_access_log }} combined;
    error_log {{ nginx_error_log }} warn;

    location / {
        try_files $uri $uri/ =404;
    }

    # Pass PHP scripts to FastCGI server
    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:{{ php_fpm_sock_path | default('/run/php/php-fpm.sock') }};
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include fastcgi_params;
    }

    # Deny access to .git and hidden files
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }
}
