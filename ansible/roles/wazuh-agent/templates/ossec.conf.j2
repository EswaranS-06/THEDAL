<!--
  SOCForge — Wazuh Windows Agent Configuration
  ==============================================================================
-->
<ossec_config>
  <client>
    <server>
      <address>{{ wazuh_manager_address }}</address>
      <port>{{ wazuh_manager_port }}</port>
      <protocol>{{ wazuh_agent_protocol }}</protocol>
    </server>
    <config-profile>windows, windows-server, {{ wazuh_agent_group }}</config-profile>
    <notify_time>10</notify_time>
    <time-reconnect>60</time-reconnect>
    <auto_restart>yes</auto_restart>
  </client>

  <!-- Client Event Buffer -->
  <client_buffer>
    <disabled>no</disabled>
    <queue_size>5000</queue_size>
    <events_per_second>500</events_per_second>
  </client_buffer>

  <!-- Baseline File Integrity Monitoring (FIM) -->
  <syscheck>
    <disabled>no</disabled>
    <frequency>{{ wazuh_fim_frequency }}</frequency>
    <scan_on_start>yes</scan_on_start>
    {% for path in wazuh_fim_paths %}
    <directories check_all="yes">{{ path }}</directories>
    {% endfor %}
    <ignore>C:\Windows\Temp</ignore>
    <nodiff>C:\Windows\System32\drivers\etc\hosts</nodiff>
    <skip_nfs>yes</skip_nfs>
  </syscheck>

  <!-- Windows Event Channels (High-Fidelity Telemetry) -->
  {% for channel in wazuh_windows_event_channels %}
  <localfile>
    <location>{{ channel }}</location>
    <log_format>eventchannel</log_format>
  </localfile>
  {% endfor %}

  <!-- Active Response Verification -->
  <active-response>
    <disabled>no</disabled>
    <ca_store>C:\Program Files (x86)\ossec-agent\wpk_root.pem</ca_store>
    <ca_verification>yes</ca_verification>
  </active-response>
</ossec_config>
