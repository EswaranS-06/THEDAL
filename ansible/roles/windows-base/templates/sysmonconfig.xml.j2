<Sysmon schemaversion="4.90">
  <!--
    SOCForge — Curated Microsoft Sysmon Baseline Configuration
    ==============================================================================
    Derived from SwiftOnSecurity & Olaf Hartong Sysmon Modular baselines.
    Optimized for high-fidelity endpoint detection, process lineage, network telemetry,
    and attack emulation auditing.
    ==============================================================================
  -->
  <HashAlgorithms>md5,sha256,IMPHASH</HashAlgorithms>
  <CheckRevocation/>

  <EventFiltering>
    <!-- EVENT ID 1: Process Creation -->
    <RuleGroup name="ProcessCreation" groupRelation="or">
      <ProcessCreate onmatch="exclude">
        <!-- Filter high-volume background OS noise -->
        <Image condition="is">C:\Windows\System32\audiodg.exe</Image>
        <Image condition="is">C:\Windows\System32\conhost.exe</Image>
        <Image condition="is">C:\Windows\System32\SearchIndexer.exe</Image>
      </ProcessCreate>
    </RuleGroup>

    <!-- EVENT ID 2: File Creation Time Change (Timestomping) -->
    <RuleGroup name="FileCreateTime" groupRelation="or">
      <FileCreateTime onmatch="include">
        <Image condition="contains any">powershell.exe;cmd.exe;cscript.exe;wscript.exe;rundll32.exe</Image>
      </FileCreateTime>
    </RuleGroup>

    <!-- EVENT ID 3: Network Connection Initiated -->
    <RuleGroup name="NetworkConnect" groupRelation="or">
      <NetworkConnect onmatch="include">
        <!-- Log outbound network connections from scripting engines, interpreters, and unusual processes -->
        <Image condition="contains any">powershell.exe;pwsh.exe;cmd.exe;rundll32.exe;regsvr32.exe;mshta.exe;cscript.exe;wscript.exe;certutil.exe;bitsadmin.exe;curl.exe</Image>
        <DestinationPort condition="is">445</DestinationPort>
        <DestinationPort condition="is">135</DestinationPort>
        <DestinationPort condition="is">3389</DestinationPort>
        <DestinationPort condition="is">5985</DestinationPort>
        <DestinationPort condition="is">5986</DestinationPort>
      </NetworkConnect>
      <NetworkConnect onmatch="exclude">
        <DestinationIp condition="is">127.0.0.1</DestinationIp>
        <DestinationIp condition="is">169.254.169.254</DestinationIp>
      </NetworkConnect>
    </RuleGroup>

    <!-- EVENT ID 5: Process Terminated -->
    <RuleGroup name="ProcessTerminate" groupRelation="or">
      <ProcessTerminate onmatch="include">
        <Image condition="contains any">powershell.exe;cmd.exe;Sysmon.exe;Sysmon64.exe;ossec-agent.exe;wazuh-agent.exe</Image>
      </ProcessTerminate>
    </RuleGroup>

    <!-- EVENT ID 7: Image / DLL Loaded -->
    <RuleGroup name="ImageLoad" groupRelation="or">
      <ImageLoad onmatch="include">
        <!-- Suspicious DLL loading into unmanaged or script hosts -->
        <ImageLoaded condition="contains any">samlib.dll;vaultcli.dll;wdigest.dll;cryptdll.dll;wininet.dll</ImageLoaded>
        <Image condition="contains any">powershell.exe;rundll32.exe;regsvr32.exe;mshta.exe</Image>
      </ImageLoad>
    </RuleGroup>

    <!-- EVENT ID 8: CreateRemoteThread (Process Injection) -->
    <RuleGroup name="CreateRemoteThread" groupRelation="or">
      <CreateRemoteThread onmatch="exclude">
        <SourceImage condition="is">C:\Windows\System32\csrss.exe</SourceImage>
        <SourceImage condition="is">C:\Windows\System32\svchost.exe</SourceImage>
      </CreateRemoteThread>
    </RuleGroup>

    <!-- EVENT ID 10: Process Access (LSASS & Sensitive Process Memory Access) -->
    <RuleGroup name="ProcessAccess" groupRelation="or">
      <ProcessAccess onmatch="include">
        <TargetImage condition="end with">lsass.exe</TargetImage>
        <TargetImage condition="end with">winlogon.exe</TargetImage>
      </ProcessAccess>
    </RuleGroup>

    <!-- EVENT ID 11: File Created (Scripts, Executables, Stagers) -->
    <RuleGroup name="FileCreate" groupRelation="or">
      <FileCreate onmatch="include">
        <TargetFilename condition="contains any">\Temp\;\AppData\Local\Temp\;\Downloads\;\Public\;\Start Menu\Programs\Startup\</TargetFilename>
        <TargetFilename condition="end with">.exe</TargetFilename>
        <TargetFilename condition="end with">.dll</TargetFilename>
        <TargetFilename condition="end with">.bat</TargetFilename>
        <TargetFilename condition="end with">.ps1</TargetFilename>
        <TargetFilename condition="end with">.vbs</TargetFilename>
        <TargetFilename condition="end with">.hta</TargetFilename>
      </FileCreate>
    </RuleGroup>

    <!-- EVENT ID 12, 13, 14: Registry Key Events (Persistence & Tampering) -->
    <RuleGroup name="RegistryEvent" groupRelation="or">
      <RegistryEvent onmatch="include">
        <!-- Run / RunOnce persistence keys -->
        <TargetObject condition="contains">\CurrentVersion\Run</TargetObject>
        <TargetObject condition="contains">\CurrentVersion\RunOnce</TargetObject>
        <!-- Service creation persistence -->
        <TargetObject condition="contains">\Services\</TargetObject>
        <!-- Windows Defender / Tampering -->
        <TargetObject condition="contains">\Windows Defender\Real-Time Protection</TargetObject>
        <!-- PowerShell ScriptBlock Logging Registry -->
        <TargetObject condition="contains">\Policies\Microsoft\Windows\PowerShell</TargetObject>
      </RegistryEvent>
    </RuleGroup>

    <!-- EVENT ID 22: DNS Query Logging -->
    <RuleGroup name="DnsQuery" groupRelation="or">
      <DnsQuery onmatch="exclude">
        <QueryName condition="end with">.internal</QueryName>
        <QueryName condition="end with">.local</QueryName>
        <QueryName condition="end with">amazonaws.com</QueryName>
      </DnsQuery>
    </RuleGroup>
  </EventFiltering>
</Sysmon>
