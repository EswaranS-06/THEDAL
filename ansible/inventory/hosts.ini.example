# ==============================================================================
# THEDAL — Example Ansible Inventory Template
# ==============================================================================
# Note: Do not edit `hosts.ini` directly. Generate it dynamically via:
#   python3 scripts/generate-inventory.py
# ==============================================================================

[bastion_nodes]
bastion ansible_host=203.0.113.10 ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/thedal_key

[internal_linux]
wazuh ansible_host=10.10.10.100 ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/thedal_key
web ansible_host=10.10.30.50 ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/thedal_key
attack ansible_host=10.10.20.25 ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/thedal_key

[internal_linux:vars]
ansible_ssh_common_args='-o ProxyJump=ubuntu@203.0.113.10 -o StrictHostKeyChecking=no'

[windows_nodes]
windows ansible_host=127.0.0.1 ansible_port=5985 windows_internal_ip=10.10.10.200 ansible_user=Administrator ansible_password=SOCForge@2026!Sec ansible_connection=winrm ansible_winrm_server_cert_validation=ignore ansible_winrm_transport=basic

[windows_nodes:vars]
ansible_user=Administrator
ansible_password=SOCForge@2026!Sec
ansible_connection=winrm
ansible_winrm_server_cert_validation=ignore
ansible_winrm_transport=basic
ansible_port=5985
ansible_winrm_scheme=http

[linux:children]
bastion_nodes
internal_linux

[soc_stack:children]
internal_linux
windows_nodes

[all:vars]
bastion_public_ip=203.0.113.10
ansible_python_interpreter=/usr/bin/python3
