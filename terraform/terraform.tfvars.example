# ==============================================================================
# SOCForge — Example Variable Configuration File
# ==============================================================================
# Copy this file to `terraform.tfvars` and adjust values as needed:
#   cp terraform.tfvars.example terraform.tfvars
#
# NOTE: `terraform.tfvars` is ignored by Git to avoid tracking local overrides.
# ==============================================================================

# Target AWS Region
aws_region = "ap-south-1"

# Project and Environment Naming
project_name = "SOCForge"
environment  = "lab"

# Network CIDR Blocks
vpc_cidr               = "10.10.0.0/16"
management_subnet_cidr = "10.10.1.0/24"
soc_subnet_cidr        = "10.10.10.0/24"
attack_subnet_cidr     = "10.10.20.0/24"
web_subnet_cidr        = "10.10.30.0/24"

# ------------------------------------------------------------------------------
# Access Control (Phase 3)
# ------------------------------------------------------------------------------
# IMPORTANT: Replace with your actual public IPv4 address (e.g. "203.0.113.50/32").
# Used to restrict inbound SSH / RDP / Dashboard access to authorized operators only.
admin_cidr = "127.0.0.1/32"

# EC2 SSH Key Pair configuration
ssh_key_name = "SOCForge-key"

# Paste your public key string here (e.g. from `cat ~/.ssh/id_ed25519.pub`)
# If left empty, no aws_key_pair resource is created by Terraform.
ssh_public_key = ""
