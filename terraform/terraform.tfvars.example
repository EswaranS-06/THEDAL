# ==============================================================================
# SOCForge — Example Variable Configuration File
# ==============================================================================
# Copy this file to `terraform.tfvars` and adjust values as needed:
#   cp terraform.tfvars.example terraform.tfvars
#
# NOTE: `terraform.tfvars` is ignored by Git to avoid tracking local overrides.
# ==============================================================================

# ------------------------------------------------------------------------------
# Provider & Environment
# ------------------------------------------------------------------------------
aws_region   = "ap-south-1"
project_name = "SOCForge"
environment  = "lab"

# ------------------------------------------------------------------------------
# Network CIDR Blocks
# ------------------------------------------------------------------------------
vpc_cidr               = "10.10.0.0/16"
management_subnet_cidr = "10.10.1.0/24"
soc_subnet_cidr        = "10.10.10.0/24"
attack_subnet_cidr     = "10.10.20.0/24"
web_subnet_cidr        = "10.10.30.0/24"

# ------------------------------------------------------------------------------
# Access Control (Phase 3)
# ------------------------------------------------------------------------------
# IMPORTANT: Replace with your actual public IPv4 address (e.g. "203.0.113.50/32").
# Used to restrict inbound SSH / RDP / Dashboard access to authorized operators only.
admin_cidr = "127.0.0.1/32"

# EC2 SSH Key Pair configuration
ssh_key_name = "SOCForge-key"

# Paste your public key string here (e.g. from `cat ~/.ssh/id_ed25519.pub`)
# If left empty, no aws_key_pair resource is created by Terraform.
ssh_public_key = ""

# ------------------------------------------------------------------------------
# Compute Sizing & Profiles (Phase 4)
# ------------------------------------------------------------------------------
# Minimal profile (for initial lightweight lab testing):
#   bastion_instance_type = "t3.micro"
#   wazuh_instance_type   = "t3.medium"
#   windows_instance_type = "t3.medium"
#   web_instance_type     = "t3.micro"
#   attack_instance_type  = "t3.micro"
#
# Standard profile (recommended for Wazuh multi-agent SIEM indexing):
#   wazuh_instance_type   = "t3.xlarge"   (4 vCPU, 16 GB RAM)
#   windows_instance_type = "t3.large"    (2 vCPU, 8 GB RAM)

bastion_instance_type = "t3.micro"
wazuh_instance_type   = "t3.medium"
windows_instance_type = "t3.medium"
web_instance_type     = "t3.small"
attack_instance_type  = "t3.micro"

# Wazuh storage (GB)
wazuh_root_volume_size = 50

# ------------------------------------------------------------------------------
# Static Internal Private IPv4 Addresses
# ------------------------------------------------------------------------------
bastion_private_ip = "10.10.1.10"
wazuh_private_ip   = "10.10.10.10"
windows_private_ip = "10.10.10.20"
attack_private_ip  = "10.10.20.10"
web_private_ip     = "10.10.30.10"


# Custom AMI overrides (optional; leave empty for dynamic discovery)
ubuntu_ami_id  = ""
windows_ami_id = ""
